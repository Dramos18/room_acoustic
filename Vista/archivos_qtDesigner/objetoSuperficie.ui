  <property name="windowTitle"><string>Form</string></property>
  <property name="styleSheet">
   <string notr="true">/* Contenedor del widget */
QWidget#formObjetoSuperficie {
    background: transparent;
}
QFrame { background-color: transparent; border: none; }

/* Card del objeto */
QFrame#frameObjSupCard {
    background-color: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.18);
    border-left: 2px solid rgba(126,200,247,0.60);
    border-radius: 8px;
}
QFrame#frameObjSupCard:hover {
    background-color: rgba(255,255,255,0.11);
    border-left: 2px solid rgba(126,200,247,0.90);
}

/* Inputs */
QLineEdit {
    font-size: 10px;
    font-weight: normal;
    color: white;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.30);
    border-radius: 6px;
    padding: 3px 7px;
}
QLineEdit:focus {
    border: 1px solid #7ec8f7;
    background: rgba(126,200,247,0.15);
}
QLineEdit::placeholder { color: rgba(255,255,255,0.35); }

QComboBox {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.30);
    border-radius: 6px;
    color: white;
    font-size: 10px;
    padding: 3px 6px;
}
QComboBox:focus { border: 1px solid #7ec8f7; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background-color: #001a4d;
    color: white;
    selection-background-color: rgba(126,200,247,0.30);
    border: 1px solid rgba(255,255,255,0.20);
}
QComboBox QScrollBar:vertical { border: none; background: #f0f0f0; width: 8px; }
QComboBox QScrollBar::handle:vertical { background: #bfbfbf; min-height: 16px; border-radius: 3px; }

/* Botones +/− */
QPushButton {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 5px;
    min-width: 22px; max-width: 22px;
    min-height: 22px; max-height: 22px;
}
QPushButton:hover {
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.55);
}
QPushButton:pressed { background: rgba(255,255,255,0.35); }

/* Label de unidad */
QLabel#labelUnidadArea {
    color: rgba(255,255,255,0.50);
    font-size: 9px;
    min-width: 18px; max-width: 18px;
    border: none; background: transparent;
}
</string>
  </property>

