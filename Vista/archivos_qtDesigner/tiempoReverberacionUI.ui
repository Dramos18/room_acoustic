  <property name="styleSheet">
   <string notr="true">/* ── Fondo general ── */
QWidget {
    background-color: qlineargradient(
        spread:pad, x1:0.488, y1:0, x2:0.495, y2:1,
        stop:0.306818 rgba(0,0,93,255),
        stop:0.710227 rgba(0,0,45,255)
    );
}
QFrame { background-color: transparent; border: none; }

/* ── Scrollbars globales ── */
QScrollBar:vertical {
    background: transparent; width: 7px; margin: 2px 0;
}
QScrollBar::handle:vertical {
    background-color: rgba(255,255,255,0.22); min-height: 24px; border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background-color: rgba(255,255,255,0.42); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* ── QGroupBox global (títulos de sección) ── */
QGroupBox {
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 10px;
    margin-top: 14px;
    background-color: rgba(255,255,255,0.06);
    font-size: 11px;
    font-weight: bold;
    color: rgba(255,255,255,0.80);
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: rgba(255,255,255,0.85);
    font-size: 11px;
}

/* ── Labels globales ── */
QLabel {
    color: rgba(255,255,255,0.88);
    font-size: 12px;
    font-weight: bold;
    background: transparent;
    border: none;
}

/* ── Inputs globales ── */
QLineEdit {
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 8px;
    background-color: rgba(255,255,255,0.12);
    color: white;
    font-size: 12px;
    font-weight: bold;
    padding: 5px 8px;
}
QLineEdit:focus {
    border: 1px solid #7ec8f7;
    background-color: rgba(126,200,247,0.15);
}
QLineEdit::placeholder { color: rgba(255,255,255,0.35); }

/* ── ComboBox global ── */
QComboBox {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 7px;
    color: white;
    font-size: 11px;
    padding: 4px 6px;
}
QComboBox:focus { border: 1px solid #7ec8f7; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background-color: #001a4d;
    color: white;
    selection-background-color: rgba(126,200,247,0.28);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 5px;
}
QComboBox QScrollBar:vertical { border: none; background: #f0f0f0; width: 8px; }
QComboBox QScrollBar::handle:vertical { background: #bfbfbf; min-height: 16px; border-radius: 3px; }
QComboBox QScrollBar::add-line:vertical, QComboBox QScrollBar::sub-line:vertical { height: 0; }

/* ── CheckBox global ── */

QCheckBox {
    background: transparent;
    color: rgba(255,255,255,0.85);
    font-size: 11px;
   
}


QCheckBox::indicator:hover { background: rgba(255,255,255,0.30); }
QCheckBox::indicator:checked {
    background: rgba(126,200,247,0.55);
    border: 1px solid #7ec8f7;
}
QCheckBox::indicator {
    width: 17px; height: 17px;
    border-radius: 4px;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.45);
}

/* ── DoubleSpinBox / SpinBox ── */
QDoubleSpinBox, QSpinBox {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 6px;
    padding: 4px 6px;
    color: white;
    font-weight: bold;
    font-size: 11px;
}
QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #7ec8f7; }



/* ── Widgets deshabilitados ── */
QLabel:disabled, QLineEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled, QCheckBox:disabled {
    color: rgba(255,255,255,0.35);
}
QGroupBox:disabled {
    background-color: rgba(80,80,80,0.18);
    border-color: rgba(255,255,255,0.12);
}
QGroupBox::title:disabled { color: rgba(255,255,255,0.28); }
</string>
