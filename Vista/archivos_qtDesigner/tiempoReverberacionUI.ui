    margin-top: 14px;
}
QGroupBox#boxSuperficies::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: rgba(255,255,255,0.80);
    font-size: 11px;
}
/* Card de cada superficie */
QFrame[class=&quot;cardSuperficie&quot;] {
    border-radius: 9px;
    background-color: rgba(255,255,255,0.07);
}
