  <property name="styleSheet">
   <string notr="true">/* ── Fondo principal ── */

QWidget{
background-color: qlineargradient(spread:pad, x1:0.488, y1:0, x2:0.495, y2:1, stop:0.306818 rgba(0, 0, 93, 255), stop:0.710227 rgba(0, 0, 45, 255))
}



/* ── Frames internos transparentes ── */
QFrame {
    background-color: transparent;
    border: none;
}

/* ── Separador horizontal ── */
QFrame#lineSeparador {
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
    min-height: 0px;
    max-height: 0px;
}

/* ── Título principal ── */
QLabel#labelMainTittle {
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 28pt;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}

/* ── Subtítulo / descripción ── */
QLabel#labelSubTitulo {
    color: rgba(180, 210, 255, 0.85);
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 11pt;
    font-weight: 400;
    background: transparent;
}

/* ── Label GIF ── */
QLabel#labelSuperior {
    background: transparent;
}

/* ── Botón primario: Iniciar ── */
QPushButton#botonIniciar {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0.0 rgba(30, 80, 200, 255),
        stop:1.0 rgba(60, 140, 255, 255)
    );
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 15pt;
    font-weight: 700;
    border: none;
    border-radius: 18px;
    padding: 14px 30px;
    letter-spacing: 1px;
}
QPushButton#botonIniciar:hover {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0.0 rgba(50, 110, 230, 255),
        stop:1.0 rgba(90, 170, 255, 255)
    );
}
QPushButton#botonIniciar:pressed {
    background-color: rgba(30, 60, 160, 255);
}

/* ── Botón secundario: Ayuda ── */
QPushButton#botonAyuda {
    background-color: transparent;
    color: rgba(180, 210, 255, 0.90);
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 12pt;
    font-weight: 500;
    border: 1px solid rgba(150, 190, 255, 0.45);
    border-radius: 18px;
    padding: 10px 30px;
    letter-spacing: 0.5px;
}
QPushButton#botonAyuda:hover {
    background-color: rgba(100, 160, 255, 0.12);
    border: 1px solid rgba(180, 210, 255, 0.70);
    color: #FFFFFF;
}
QPushButton#botonAyuda:pressed {
    background-color: rgba(100, 160, 255, 0.25);
}

/* ── Footer labels ── */
QLabel#labelUniversidad {
    color: rgba(180, 210, 255, 0.60);
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 8pt;
    background: transparent;
}
QLabel#labelVersion {
    color: rgba(180, 210, 255, 0.40);
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 8pt;
    background: transparent;
}
</string>
