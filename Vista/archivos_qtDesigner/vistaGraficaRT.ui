QScrollArea {
    border: none;
    background: transparent; /* Opcional */
}


   QScrollBar:vertical {
        background: transparent;
        width: 8px;
        margin: 2px 0 2px 0;
    }

    QScrollBar::handle:vertical {
        background-color: rgba(100, 100, 100, 120);  /* color gris suave */
        min-height: 25px;
        border-radius: 4px;
    }

    QScrollBar::handle:vertical:hover {
        background-color: rgba(80, 80, 80, 160);  /* más oscuro al pasar el mouse */
    }

    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
        background: none;
    }

    QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
        background: none;
    }

    QScrollBar:horizontal {
        background: transparent;
        height: 8px;
        margin: 0 2px 0 2px;
    }

    QScrollBar::handle:horizontal {
        background-color: rgba(100, 100, 100, 120);
        min-width: 25px;
        border-radius: 4px;
    }

    QScrollBar::handle:horizontal:hover {
        background-color: rgba(80, 80, 80, 160);
    }

    QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
        width: 0px;
        background: none;
    }

    QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
        background: none;
    }</string>
